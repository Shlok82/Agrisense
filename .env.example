# Copy to .env in the project root (same folder as package.json)
# Get a key from https://aistudio.google.com/apikey
VITE_GEMINI_API_KEY=

# MongoDB Connection String
# For local MongoDB: mongodb://localhost:27017/agrisense
# For MongoDB Atlas (cloud):
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/agrisense?retryWrites=true&w=majority